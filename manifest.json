{
  "manifest_version": 3,
  "name": "youtweaks",
  "version": "1.0",
  "description": "Take control of your YouTube experience. YouTweaks lets you hide distracting elements like Shorts, thumbnails, hover previews, recommendation bars, AI features, merchandise shelves, and more. Includes a daily time tracker with usage limits and bedtime cutoffs to help you stay focused.",
   "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tubetweaks@kann",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
"action": {
  "default_title": "YouTweaks",
  "default_popup": "popup/popup.html",
  "default_icon": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
},
"content_scripts": [
  {
    "matches": ["https://www.youtube.com/*"],
    "js": ["content_scripts/theme_presets.js",
           "content_scripts/theme.js",
           "content_scripts/timetracker.js",
           "content_scripts/youtweaks.js",
           "content_scripts/videometa.js",
           "content_scripts/playbackspeed.js"],
    "css": ["content_scripts/youtweaks.css"],
    "run_at": "document_start"
  }
]
}
